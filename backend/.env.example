# Flask and application settings
SECRET_KEY=your_secure_secret_key
JWT_SECRET_KEY=your_secure_jwt_key
ADMIN_TOKEN=your_admin_token
FLASK_ENV=production

# Aiven MySQL database connection
AIVEN_HOST=your_aiven_host.aivencloud.com
AIVEN_PORT=your_aiven_port
AIVEN_USER=your_aiven_user
AIVEN_PASSWORD=your_aiven_password
AIVEN_DB=your_aiven_dbname

# Aiven SSL configuration - either provide the path or the content
# Option 1: Path to CA certificate
AIVEN_CA_PATH=/app/credentials/ca.pem

# Option 2: CA certificate content (if you can't mount a file)
# AIVEN_CA_PEM=-----BEGIN CERTIFICATE-----\nYour certificate content here\n-----END CERTIFICATE-----

# Face recognition settings
FACE_DETECTOR_BACKEND=retinaface
MATCH_THRESHOLD=0.60
MAX_IMAGE_SIZE=2048

# Attendance settings
DEBOUNCE_SECONDS=30
EVENT_DEBOUNCE_SECONDS=30

# Upload folder
UPLOAD_FOLDER=uploads

# CORS settings (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Drive integration (if using)
# GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/your-credentials.json

# Bulk import settings
BULK_IMPORT_BATCH_SIZE=50
BULK_IMPORT_TIMEOUT=3600
MAX_IMPORT_ROWS=5000