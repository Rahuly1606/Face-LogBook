# Database Configuration (Aiven MySQL)
# Get credentials from https://aiven.io
# AIVEN_MYSQL_HOST=your-mysql-host.aivencloud.com
# AIVEN_MYSQL_PORT=12345
# AIVEN_MYSQL_USER=avnadmin
# AIVEN_MYSQL_PASSWORD=your-password
# AIVEN_MYSQL_DATABASE=defaultdb

# File upload settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760  # 10MB

# Face recognition settings
INSIGHTFACE_MODEL_ROOT=./models
MATCH_THRESHOLD=0.60

# CORS configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:8080

# Google Drive service account (optional)
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/credentials.json
